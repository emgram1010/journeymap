{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "copilot-approvals-mock",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "--directory",
        "webapp/copilot-approvals-mock"
      ],
      "port": 5180
    },
    {
      "name": "protype-2",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "webapp/protype-2",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "protype-2-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "webapp/protype-2",
        "run",
        "dev",
        "--",
        "--port",
        "3011",
        "--strictPort"
      ],
      "port": 3011
    },
    {
      "name": "protype-2-repeat-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "webapp/protype-2",
        "run",
        "dev",
        "--",
        "--mode",
        "repeatui",
        "--port",
        "3012",
        "--strictPort"
      ],
      "port": 3012
    }
  ]
}